# =============================================================================
# .dockerignore — berlaku untuk semua docker build dari project root (PADIS/)
# =============================================================================

# --- Secrets & environment ---
.env
**/.env
**/.env.*
*.env
backend/.env

# --- Python cache ---
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache/
**/.mypy_cache/

# --- Data (di-mount saat runtime, tidak di-bake ke image) ---
backend/data/
data/
db/data/
db/db-backup/

# --- Frontend (tidak relevan untuk pipeline image) ---
frontend/
frontend/node_modules/
frontend/.next/

# --- Docs & scripts non-pipeline ---
docs/
backend/scripts/debug/

# --- Git & IDE ---
.git/
.gitignore
.gitattributes
.idea/
.vscode/
*.code-workspace

# --- Venv ---
.venv/
venv/
env/

# Catatan: backend/app/ dan backend/run.py TIDAK di-ignore di sini —
# Dockerfile.pipeline hanya COPY backend/scripts/ eksplisit, jadi
# mengecualikan file-file Flask dari .dockerignore tidak lagi dibutuhkan.
# Sebaliknya, mengecualikannya membuat Railpack (yang membaca dockerignore)
# kehilangan entry point aplikasi web dan gagal mendeteksi start command.
